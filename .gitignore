/research/data/platform/interim/**/*.feather
/research/data/platform/interim/**/*.sqlite*
/research/models/**/*.joblib
/research/models/**/*.pkl
/research/models/**/*.pickle
/research/models/**/*.ckpt
/research/models/**/*.pt
/research/models/**/*.pth
/research/models/**/*.onnx
/research/models/**/*.bin
/research/reports/**/.deck_build/node_modules/
/research/reports/**/.deck_revision/node_modules/
/research/reports/**/rendered/

# Third-party literature is cataloged and reviewed in Git, but article and
# supplementary source bytes are not redistributed from this public repository.
/research/literature/**/*.pdf
/research/literature/**/*.mov
/research/literature/**/*.mp4
/research/literature/**/*.docx
/research/literature/**/*.xlsx

