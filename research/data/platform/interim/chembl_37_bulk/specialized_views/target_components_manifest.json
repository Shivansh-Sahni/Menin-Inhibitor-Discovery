  "query": "SELECT t.\"chembl_id\" AS \"target_chembl_id\", t.\"pref_name\" AS \"target_name\", t.\"target_type\" AS \"target_type\", t.\"organism\" AS \"target_organism\", t.\"tax_id\" AS \"target_tax_id\", tc.\"component_id\" AS \"component_id\", tc.\"homologue\" AS \"homologue\", cs.\"accession\" AS \"accession\", cs.\"component_type\" AS \"component_type\", cs.\"sequence\" AS \"sequence\", cs.\"sequence_md5sum\" AS \"sequence_md5sum\", cs.\"organism\" AS \"component_organism\", cs.\"tax_id\" AS \"component_tax_id\"\nFROM target_dictionary AS t\nLEFT JOIN target_components AS tc ON t.tid = tc.tid\nLEFT JOIN component_sequences AS cs ON tc.component_id = cs.component_id\nORDER BY t.chembl_id, tc.component_id",
