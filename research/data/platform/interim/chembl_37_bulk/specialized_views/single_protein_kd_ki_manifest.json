  "query": "SELECT a.\"activity_id\" AS \"activity_id\", a.\"action_type\" AS \"action_type\", a.\"activity_comment\" AS \"activity_comment\", a.\"bao_endpoint\" AS \"bao_endpoint\", a.\"data_validity_comment\" AS \"data_validity_comment\", a.\"potential_duplicate\" AS \"potential_duplicate\", a.\"qudt_units\" AS \"qudt_units\", a.\"record_id\" AS \"record_id\", a.\"relation\" AS \"relation\", a.\"src_id\" AS \"src_id\", a.\"standard_flag\" AS \"standard_flag\", a.\"standard_relation\" AS \"standard_relation\", a.\"standard_text_value\" AS \"standard_text_value\", a.\"standard_type\" AS \"standard_type\", a.\"standard_units\" AS \"standard_units\", a.\"standard_upper_value\" AS \"standard_upper_value\", a.\"standard_value\" AS \"standard_value\", a.\"text_value\" AS \"text_value\", a.\"toid\" AS \"toid\", a.\"type\" AS \"type\", a.\"units\" AS \"units\", a.\"uo_units\" AS \"uo_units\", a.\"upper_value\" AS \"upper_value\", a.\"value\" AS \"value\", a.\"modality\" AS \"modality\", s.\"chembl_id\" AS \"assay_chembl_id\", s.\"description\" AS \"assay_description\", s.\"assay_type\" AS \"assay_type\", s.\"assay_test_type\" AS \"assay_test_type\", s.\"assay_category\" AS \"assay_category\", s.\"assay_organism\" AS \"assay_organism\", s.\"assay_tax_id\" AS \"assay_tax_id\", s.\"assay_strain\" AS \"assay_strain\", s.\"assay_tissue\" AS \"assay_tissue\", s.\"assay_cell_type\" AS \"assay_cell_type\", s.\"assay_subcellular_fraction\" AS \"assay_subcellular_fraction\", s.\"relationship_type\" AS \"relationship_type\", s.\"src_assay_id\" AS \"src_assay_id\", s.\"cell_id\" AS \"cell_id\", s.\"tissue_id\" AS \"tissue_id\", s.\"variant_id\" AS \"variant_id\", s.\"assay_group\" AS \"assay_group\", s.\"bao_format\" AS \"bao_format\", s.\"confidence_score\" AS \"confidence_score\", t.\"chembl_id\" AS \"target_chembl_id\", t.\"pref_name\" AS \"target_pref_name\", t.\"target_type\" AS \"target_type\", t.\"organism\" AS \"target_organism\", t.\"tax_id\" AS \"target_tax_id\", m.\"chembl_id\" AS \"molecule_chembl_id\", m.\"pref_name\" AS \"molecule_pref_name\", cs.\"canonical_smiles\" AS \"canonical_smiles\", cs.\"standard_inchi_key\" AS \"standard_inchi_key\", d.\"chembl_id\" AS \"document_chembl_id\", d.\"journal\" AS \"document_journal\", d.\"year\" AS \"document_year\", d.\"doi\" AS \"document_doi\", d.\"pubmed_id\" AS \"pubmed_id\", d.\"patent_id\" AS \"patent_id\", d.\"title\" AS \"document_title\", d.\"doc_type\" AS \"document_type\", d.\"chembl_release_id\" AS \"document_chembl_release_id\", sd.\"src_short_name\" AS \"activity_source_name\", sd.\"src_description\" AS \"activity_source_description\", comp.component_accessions AS \"component_accessions\", comp.component_sequences AS \"component_sequences\", comp.component_types AS \"component_types\"\nFROM activities AS a\nLEFT JOIN assays AS s ON a.assay_id = s.assay_id\nLEFT JOIN target_dictionary AS t ON s.tid = t.tid\nLEFT JOIN molecule_dictionary AS m ON a.molregno = m.molregno\nLEFT JOIN compound_structures AS cs ON a.molregno = cs.molregno\nLEFT JOIN docs AS d ON a.doc_id = d.doc_id\nLEFT JOIN \"source\" AS sd ON a.src_id = sd.src_id\nLEFT JOIN (\n    SELECT ordered.tid,\n           GROUP_CONCAT(ordered.accession, ';') AS component_accessions,\n           GROUP_CONCAT(ordered.sequence, ';') AS component_sequences,\n           GROUP_CONCAT(ordered.component_type, ';') AS component_types\n    FROM (\n        SELECT tc.tid,\n               COALESCE(cs.accession, '') AS accession,\n               COALESCE(cs.sequence, '') AS sequence,\n               COALESCE(cs.component_type, '') AS component_type\n        FROM target_components AS tc\n        LEFT JOIN component_sequences AS cs ON tc.component_id = cs.component_id\n        ORDER BY tc.tid, tc.component_id, cs.accession\n    ) AS ordered\n    GROUP BY ordered.tid\n) AS comp ON t.tid = comp.tid\nWHERE a.activity_id > ? AND (upper(t.target_type) = 'SINGLE PROTEIN' AND upper(a.standard_type) IN ('KD','KI') AND a.standard_value IS NOT NULL AND a.standard_value > 0 AND lower(a.standard_units) IN ('pm','picomolar','nm','nanomolar','um','micromolar','mm','millimolar','m','molar'))\nORDER BY a.activity_id\nLIMIT ?",
